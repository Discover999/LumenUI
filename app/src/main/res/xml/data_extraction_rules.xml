<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up: the only persisted state is the backend list, whose secret is
     encrypted with a Keystore key that cannot be restored onto another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
